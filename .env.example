# Cloudflare cache purge after each deploy (Coolify post-deployment command: npm run purge-cdn).
# The token needs Zone > Cache Purge on gregrickaby.com. Without these, the purge is skipped.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Post likes (lib/likes.ts). Leave the path empty locally to use .data/likes.db. In Coolify, set it
# to a file on the persistent volume, /app/data/likes.db, so likes survive deploys.
# The salt keeps hashed visitor IPs from being reversed; set it once and never change it.
LIKES_DB_PATH=
LIKES_SALT=

# Datadog (optional). Without these the server logs to stdout, sends no traces, and RUM is off.
# The browser values inline at build time, so Coolify needs them when it builds, not only at runtime.
# `npm start` preloads dd-trace, which sends traces to the agent at DD_AGENT_HOST. Set DD_VERSION to
# the deploy's commit ($SOURCE_COMMIT in Coolify, which next.config.ts also uses for deploymentId),
# so traces and RUM sessions group by deploy.
# DD_APM_IGNORE_RESOURCES is an agent setting: set it on the Datadog Agent service to skip
# GET /api/health and its every-few-seconds health check.
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_SERVICE=gregrickaby
DD_ENV=production
DD_VERSION=
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=
DD_RUNTIME_METRICS_ENABLED=
DD_APPLICATION_ID=
DD_CLIENT_TOKEN=
