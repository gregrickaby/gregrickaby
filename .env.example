# Contact form email (Mailgun SMTP). Without these, the form reports a send failure.
MAILGUN_LOGIN=
MAILGUN_PASSWORD=

# Keeps Server Action IDs stable across builds. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Cloudflare cache purge after each deploy (Coolify post-deployment command: npm run purge-cdn).
# The token needs Zone > Cache Purge on gregrickaby.com. Without these, the purge is skipped.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
