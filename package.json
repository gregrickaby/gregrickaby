{
  "name": "gregrickaby",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "My personal website",
  "scripts": {
    "dev": "npm run content -- --drafts && next dev --experimental-https",
    "build": "npm run content && npm run css:types && next build",
    "start": "NODE_OPTIONS='--require dd-trace/init' next start",
    "content": "node scripts/build-content.ts",
    "purge-cdn": "node scripts/purge-cdn.ts",
    "lint": "eslint && stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "css:types": "hcm \"{app,components}/**/*.module.css\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run content -- --drafts && npm run css:types && npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregrickaby/gregrickaby.git"
  },
  "author": "Greg Rickaby",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gregrickaby/gregrickaby/issues"
  },
  "homepage": "https://gregrickaby.com",
  "dependencies": {
    "@datadog/browser-logs": "7.16.2",
    "@datadog/browser-rum-nextjs": "7.16.2",
    "@datadog/browser-rum-slim": "7.16.2",
    "dd-trace": "6.21.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "2.2.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@next/playwright": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "exifr": "7.1.3",
    "gray-matter": "4.0.3",
    "happy-css-modules": "5.0.2",
    "happy-dom": "21.0.4",
    "image-size": "2.0.4",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "rehype-pretty-code": "0.14.5",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sanitize-html": "2.18.1",
    "shiki": "4.5.0",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
