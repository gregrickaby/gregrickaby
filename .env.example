# Cloudflare cache purge after each deploy (Coolify post-deployment command: npm run purge-cdn).
# The token needs Zone > Cache Purge on gregrickaby.com. Without these, the purge is skipped.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Post likes (lib/likes.ts). Leave the path empty locally to use .data/likes.db. In Coolify, set it
# to a file on the persistent volume, /app/data/likes.db, so likes survive deploys.
# The salt keeps hashed visitor IPs from being reversed; set it once and never change it.
LIKES_DB_PATH=
LIKES_SALT=
